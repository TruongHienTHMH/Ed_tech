# ==============================================================================
# DATAWITHLY PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 2. GOOGLE APPS SCRIPT CMS & LEADS CONFIGURATION (SECURITY SPLIT)
# ==============================================================================

# PUBLIC CONTENT CMS CONFIGURATION (Public Read-Only Content & Catalog Sync)
GOOGLE_APPS_SCRIPT_CMS_URL="https://script.google.com/macros/s/your_cms_deployment_id/exec"
GOOGLE_APPS_SCRIPT_CMS_SECRET="your_shared_cms_secret_here"

# PRIVATE LEADS INGESTION CONFIGURATION (Private Student Lead Capture & Processing)
GOOGLE_APPS_SCRIPT_LEADS_URL="https://script.google.com/macros/s/your_leads_deployment_id/exec"
GOOGLE_APPS_SCRIPT_LEADS_SECRET="your_shared_leads_secret_here"
LEADS_SPREADSHEET_ID="your_leads_spreadsheet_id_here"

# BACKWARD COMPATIBILITY FALLBACK (Legacy configuration fallback)
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/your_deployment_id/exec"
GOOGLE_APPS_SCRIPT_SECRET="your_shared_secret_here"

# ==============================================================================
# 3. ISR REVALIDATION CONFIGURATION
# ==============================================================================
# On-demand ISR Revalidation Secret Token (Used by CMS Webhooks to purge static cache)
REVALIDATION_SECRET="datawithly_secure_reval_token_2026"

# ==============================================================================
# 4. IMAGE STORAGE CONFIGURATION
# Options:
# - 'local' (Default): Free local disk storage in public/uploads/ (No credit card needed)
# - 'cloudflare_r2': Cloudflare R2 object storage (Requires credit card for R2 activation)
# - 'cloudinary': Cloudinary cloud storage (Free tier without credit card)
# ==============================================================================
STORAGE_PROVIDER="local"

# Cloudflare R2 Credentials (Optional - configure when switching to cloudflare_r2)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="datawithly-assets"
CLOUDFLARE_R2_PUBLIC_DOMAIN=""

# ==============================================================================
# 5. MARKETING & ANALYTICS IDS (Optional)
# ==============================================================================
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
