# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strict ignore, keep only sanitized .env.example)
.env
.env*.local
.env.development
.env.test
.env.production
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials, keys & local secret notes
*.pem
*.key
credentials*.json
service-account*.json
*.local.txt
*.local.md

# python generate and xlsx file
*.xlsx
*.py

# app_script code & clasp credentials
/*.gs
.clasp.json
.clasprc.json

.docs/deployment/VERCEL_DEPLOYMENT_GUIDE.md
