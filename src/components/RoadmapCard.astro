---
const { item } = Astro.props;
---
<article class="roadmap-card"><div class="roadmap-number">{String(item.data.order).padStart(2, '0')}</div><p class="eyebrow">{item.data.category}</p><h3>{item.data.title}</h3><p>{item.data.summary}</p><div class="meta"><span>{item.data.steps.length} chặng</span><span>{item.data.duration}</span></div><a class="detail-link" href={`/roadmaps/${item.id}/`}>Xem lộ trình <span>→</span></a></article>
