---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() {
  const items = await getCollection('roadmaps', ({ data }) => data.published);
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={`${item.data.title} | EduPath`} description={item.data.summary}>
  <article class="detail-page"><a class="back-link" href="/#roadmaps">← Tất cả lộ trình</a><p class="eyebrow">{item.data.category} · {item.data.duration}</p><h1>{item.data.title}</h1><p class="lead">{item.data.summary}</p><ol class="timeline">{item.data.steps.map((step, index) => <li><b>{String(index + 1).padStart(2, '0')}</b><span>{step}</span></li>)}</ol><div class="prose"><Content /></div><button class="button js-consult" type="button">Nhận tư vấn lộ trình</button></article>
</BaseLayout>
